{
  "name": "appxray",
  "version": "0.1.0",
  "description": "Find desktop apps on Windows and Linux that ship outdated or vulnerable embedded Chromium/Electron runtimes.",
  "license": "MIT",
  "author": "nirajkhetre",
  "homepage": "https://github.com/nirajkhetre/appxray#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirajkhetre/appxray.git"
  },
  "bugs": {
    "url": "https://github.com/nirajkhetre/appxray/issues"
  },
  "type": "module",
  "bin": {
    "appxray": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data/appxray-db.json",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "keywords": [
    "security",
    "electron",
    "chromium",
    "vulnerability-scanner",
    "cve",
    "kev",
    "desktop-apps",
    "windows",
    "linux",
    "sbom"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:real": "vitest run --config vitest.real.config.ts",
    "db:build": "node dist/cli.js db update --output data/appxray-db.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
